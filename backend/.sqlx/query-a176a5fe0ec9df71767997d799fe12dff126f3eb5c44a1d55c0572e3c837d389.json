{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                n.id,\n                n.user_id,\n                n.endpoint,\n                n.expiration_time,\n                n.p256dh,\n                n.auth\n            FROM notification_subscription n\n            INNER JOIN users u ON u.id = n.user_id\n            WHERE\n                u.username = $1\n            ",
