{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                t.id,\n                t.month_id,\n                t.amount,\n                t.date,\n                t.description,\n                t.notes,\n                t.split_mode as \"split_mode: SplitMode\"\n            FROM transactions t\n            INNER JOIN months m ON m.id = t.month_id\n            WHERE m.year = $1 AND m.month = $2\n            ORDER BY t.date DESC\n            ",
