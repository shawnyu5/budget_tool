  "query": "\n                INSERT INTO budget_allocations (id, month_id, percentage_allocation, contribution_amount, user_id)\n                SELECT\n                    $3,\n                    m.id,\n                    $4,\n                    $5,\n                    $6\n                FROM months m\n                WHERE m.year = $1 AND m.month = $2\n                RETURNING *;\n                ",
