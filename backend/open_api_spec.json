{
  "openapi": "3.1.0",
  "info": {
    "title": "budget-tool_backend",
    "version": "0.2.0"
  },
  "paths": {
    "/": {
      "get": {
        "operationId": "app_version",
        "responses": {
          "200": {
            "description": "Version of the server",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HomeResponse"
                }
              }
            }
          },
          "500": {
            "description": "Failed to get the vesion of the server",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/auth/validate-token": {
      "get": {
        "summary": "Validate the JWT token in the header.\nUm I kinda forgot to implement this route. So this route will always return true",
        "operationId": "validate_token",
        "responses": {
          "200": {
            "description": "The JWT token is still valid"
          },
          "401": {
            "description": "Authenication token expired. Please reauthenicate",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Authenication failed",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Failed to get update spending item",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/auth/validate-token/v2": {
      "get": {
        "summary": "Validate the JWT token in the header fr this time.\nBy checking the JWT token in the authorization header is still valid or not",
        "operationId": "validate_token_v2",
        "responses": {
          "200": {
            "description": "The JWT token is still valid"
          },
          "403": {
            "description": "JWT has expired",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/export/{year}/{month}/csv": {
      "get": {
        "summary": "Gets the spending items in csv form. If converting budget information to CSV fails at any point, partial data will not be returned",
        "operationId": "export_csv_handler",
        "parameters": [
          {
            "name": "year",
            "in": "path",
            "description": "The year the spending item is in",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "month",
            "in": "path",
            "description": "The month the spending item is in",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Month"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Spending items in CSV format",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Authenication token expired. Please reauthenicate",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Authenication failed",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "description": "Failed to get update spending item",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/graphql": {
      "post": {
        "summary": "Handler for graphql requests",
        "operationId": "graphql_handler",
        "responses": {
          "200": {
            "description": "GraphQL response"
          }
        }
      }
    },
    "/login/basic": {
      "post": {
        "operationId": "basic_auth_handler",
        "responses": {
          "200": {
            "description": "Login successful. Returns a JWT token",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Authenication token expired. Please reauthenicate",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Authenication failed",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/login/basic/v2": {
      "post": {
        "summary": "Better implemented version of the basic auth handler, using proper axum_extra constructs. This handler should behave the exact same as previous",
        "operationId": "basic_auth_handler_v2",
        "responses": {
          "200": {
            "description": "Login successful. Returns a JWT token",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Authenication token expired. Please reauthenicate",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "Authenication failed",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HomeResponse": {
        "type": "object",
        "required": [
          "version"
        ],
        "properties": {
          "version": {
            "type": "string"
          }
        }
      },
      "Month": {
        "type": "string",
        "enum": [
          "January",
          "February",
          "March",
          "April",
          "May",
          "June",
          "July",
          "August",
          "September",
          "October",
          "November",
          "December"
        ]
      }
    }
  }
}