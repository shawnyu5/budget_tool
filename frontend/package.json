{
   "name": "example-basic",
   "type": "module",
   "scripts": {
      "dev": "vinxi dev",
      "build": "vinxi build",
      "postbuild": "rm -f .output/public/mockServiceWorker.js* && rm -f .vercel/output/static/mockServiceWorker.js*",
      "test": "playwright test",
      "test:ui": "playwright test --ui",
      "start": "vinxi start",
      "openapi": "npx npx @hey-api/openapi-ts -f hey-api.config.ts",
      "graphql": "graphql-codegen --config codegen.ts",
      "codegen": "npm run openapi && npm run graphql",
      "version": "vinxi version"
   },
   "dependencies": {
      "@hey-api/client-axios": "^0.9.1",
      "@rnwonder/solid-date-picker": "^1.5.0",
      "@solidjs/meta": "^0.29.4",
      "@solidjs/router": "^0.15.0",
      "@solidjs/start": "^1.1.3",
      "axios": "^1.7.9",
      "axios-retry": "^4.5.0",
      "graphql": "^16.11.0",
      "graphql-request": "^7.2.0",
      "graphql-tag": "^2.12.6",
      "pino": "^9.5.0",
      "solid-js": "^1.9.2",
      "ts-pattern": "^5.9.0",
      "vinxi": "^0.5.3",
      "zod": "^3.25.63"
   },
   "overrides": {
      "vite": "5.4.10"
   },
   "engines": {
      "node": ">=18"
   },
   "devDependencies": {
      "@graphql-codegen/cli": "5.0.7",
      "@graphql-codegen/introspection": "4.0.3",
      "@graphql-codegen/typescript": "4.1.6",
      "@graphql-codegen/typescript-graphql-request": "^6.3.0",
      "@hey-api/client-fetch": "^0.13.1",
      "@hey-api/openapi-ts": "^0.85.2",
      "@playwright/test": "^1.49.1",
      "@types/node": "^22.10.2",
      "msw": "^2.7.0"
   },
   "msw": {
      "workerDirectory": [
         "public",
         "e2e"
      ]
   }
}
